# Xiaomi Pad 5 (nabu) configuration fragment, merged on top of the upstream
# arm64 defconfig and nixpkgs' common kernel configuration.
#
# This kernel tracks nixpkgs' `linux_latest` (see ../default.nix), so unlike
# the pinned downstream fork (see ../../sm8150-fork) it does not come with an
# sm8150 defconfig.  `default.nix` therefore disables nixpkgs' autoModules:
# with autoModules the generator answers "m" to every driver the tree offers
# (several thousand modules, well over 10 GiB of build directory, hours of
# build time), which is neither what a tablet kernel needs nor reproducible on
# a small builder.  The drivers nabu actually uses are listed explicitly here
# instead — the list is derived from the downstream `sm8150.config` fragment.
#
# Syntax: "<SYMBOL> <value>" is a hard requirement, "<SYMBOL>? <value>" lets
# kconfig pick another value when the dependencies are not met (an "unused
# option" is a build error on arm64, see generate-config.pl).  The resolved
# values are re-checked in postConfigure against ./required-nabu.config.

# --- Tablet sizing ----------------------------------------------------------
# nixpkgs' common config pins 384 CPUs; the device has 8.
NR_CPUS 8
# The source is a tarball without git metadata; pinning keeps the release
# ("7.2.3") independent of how the tree was obtained, which NixOS' module
# directories and the ESP image depend on.
LOCALVERSION_AUTO n

# --- Build size -------------------------------------------------------------
# No debug info: the device debugging workflow uses ftrace/tracepoints and
# /proc/kallsyms, none of which need DWARF, and this keeps both the build
# directory and the published kernel cache small.  nixpkgs' common config
# selects the toolchain-DWARF default and BTF, so both have to be turned off
# explicitly.
DEBUG_INFO_NONE y
DEBUG_INFO n
DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT n
DEBUG_INFO_BTF n
MODULE_ALLOW_BTF_MISMATCH? n

# --- SoC platform -----------------------------------------------------------
QCOM_GSBI? y
QCOM_LLCC? y
QCOM_OCMEM? y
QCOM_RMTFS_MEM? y
QCOM_SOCINFO? y
QCOM_APR? y
QCOM_GPI_DMA? y
QCOM_LMH? y
QCOM_SPMI_TEMP_ALARM? y
QCOM_SPMI_ADC_TM5? y
I2C_QCOM_GENI? y
PINCTRL_SM8150? y
SM_DISPCC_8250? y
SM_GCC_8150? y
SM_GPUCC_8150? y
SM_VIDEOCC_8150? y
INTERCONNECT_QCOM_OSM_L3? y
INTERCONNECT_QCOM_SM8150? y
REGULATOR_QCOM_REFGEN? y
POWER_RESET_QCOM_PON? y

# --- Storage (root filesystem lives on the UFS) -----------------------------
SCSI_UFS_QCOM y
SCSI_UFS_BSG y
PHY_QCOM_QMP_UFS? y

# --- Display -----------------------------------------------------------------
# MSM/KMS drives the panel; fbcon on tty0 shows the early boot log because the
# nabu DTB has no simple-framebuffer node.
DRM y
DRM_MSM? y
DRM_PANEL_NOVATEK_NT36523? m
BACKLIGHT_CLASS_DEVICE? y
BACKLIGHT_KTZ8866? m
REGULATOR_QCOM_LABIBB? m
BACKLIGHT_QCOM_WLED? m
SYSFB? y
FRAMEBUFFER_CONSOLE? y
FRAMEBUFFER_CONSOLE_ROTATION? y
DRM_FBDEV_EMULATION? y

# --- Touchscreen -------------------------------------------------------------
# Added by patches/0003-input-add-nt36523-touchscreen.patch.
TOUCHSCREEN_NT36523_SPI? m

# --- Audio ------------------------------------------------------------------
SLIMBUS? y
SLIM_QCOM_CTRL? y
SLIM_QCOM_NGD_CTRL? y
SND_SOC_SM8150? m
SND_SOC_CS35L41_I2C? m

# --- Power / charging -------------------------------------------------------
# qcom_fg and idtp9418 come from patches/0005-power-supply-add-nabu-charging.patch.
BATTERY_QCOM_FG? m
CHARGER_QCOM_SMB2? m
CHARGER_IDTP9418? m

# --- Notification LED and flash ---------------------------------------------
# These triggers are not auto-probed, so keep them built in.
LEDS_CLASS_MULTICOLOR? m
LEDS_QCOM_LPG? m
LEDS_QCOM_FLASH? m
LEDS_TRIGGER_PATTERN? y
LEDS_TRIGGER_ONESHOT? y
LEDS_TRIGGER_BACKLIGHT? y
LEDS_TRIGGER_ACTIVITY? y

# --- WLAN / Bluetooth -------------------------------------------------------
ATH10K? m
ATH10K_SNOC? m
QRTR? m
RPMSG_QCOM_GLINK_SMEM? m
QCOM_Q6V5_PAS? m
QCOM_WCNSS_CTRL? m
