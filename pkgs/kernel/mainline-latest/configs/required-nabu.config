# Settings that must appear verbatim in the resolved .config of the mainline
# nabu kernel.  postConfigure greps for them, so a kernel update or a patch
# rebase that silently drops a driver needed to reach the root filesystem or
# to light the panel fails the build instead of failing on the device.
#
# These are the values the current nixpkgs `linux_latest` resolves to; a
# kernel update that legitimately changes one of them (typically a driver
# moving between `m` and `y`) has to update this list in the same commit.
#
# Requirements the initrd has to be able to load are listed as modules here
# as well: nixos/hardware-nabu.nix adds them to the initramfs by module name.

# EFI stub boot chain (systemd-boot loads kernel + initrd + DTB from the ESP)
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_OF=y
CONFIG_FW_LOADER=y
CONFIG_EXT4_FS=y

# UFS root storage
CONFIG_SCSI_UFSHCD=m
CONFIG_SCSI_UFS_QCOM=m
CONFIG_PHY_QCOM_QMP_UFS=m

# Display: MSM/KMS drives the panel, fbcon on tty0 shows early boot logs
CONFIG_DRM=y
CONFIG_DRM_MSM=m
CONFIG_SYSFB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_DRM_FBDEV_EMULATION=y

# nabu devices
CONFIG_DRM_PANEL_NOVATEK_NT36523=m
CONFIG_BACKLIGHT_KTZ8866=m
CONFIG_TOUCHSCREEN_NT36523_SPI=m
CONFIG_SND_SOC_SM8150=m
CONFIG_SND_SOC_CS35L41_I2C=m
CONFIG_BATTERY_QCOM_FG=m
CONFIG_CHARGER_IDTP9418=m
CONFIG_CHARGER_QCOM_SMB2=m

# Coprocessors, Wi-Fi and RMTFS
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_RMTFS_MEM=m
CONFIG_QCOM_WCNSS_CTRL=m
CONFIG_ATH10K=m
CONFIG_ATH10K_SNOC=m
CONFIG_QRTR=m

# Tablet-sized CPU count (nixpkgs' common config pins 384)
CONFIG_NR_CPUS=8
