@@ -814,7 +908,7 @@
 	dma_resv_assert_held(dmabuf->resv);
 
 	return dma_mmap_coherent(buf->dev, vma, buf->virt,
-				 fastrpc_ipa_to_dma_addr(buf->fl->cctx, buf->dma_addr), size);
+				 buf->dma_handle, size);
 }
 
 static const struct dma_buf_ops fastrpc_dma_buf_ops = {
@@ -847,6 +941,11 @@
 
 	INIT_LIST_HEAD(&map->node);
 	kref_init(&map->refcount);
+
+	if (fl->cctx->nabu_sdsp && (attr & FASTRPC_ATTR_SECUREMAP)) {
+		kfree(map);
+		return -EOPNOTSUPP;
+	}
 
 	map->fl = fl;
 	map->fd = fd;
@@ -883,6 +982,28 @@
 		err = -EINVAL;
 		goto map_err;
 	}
+	if (fl->cctx->nabu_sdsp) {
+		struct scatterlist *sg;
+		dma_addr_t base = sg_dma_address(table->sgl);
+		u64 total = 0;
+		unsigned int i;
+
+		for_each_sg(table->sgl, sg, table->nents, i) {
+			if (sg_dma_address(sg) != base + total ||
+			    check_add_overflow(total, (u64)sg_dma_len(sg), &total)) {
+				err = -EINVAL;
+				goto map_err;
+			}
+		}
+		if (len > total) {
+			err = -EINVAL;
+			goto map_err;
+		}
+		err = fastrpc_alias_map(sess->dev, base, total,
+					fastrpc_sid_offset(fl->cctx, fl->sctx), &map->alias);
+		if (err)
+			goto map_err;
+	}
 	map->va = sg_virt(map->table->sgl);
 	map->len = len;
 
@@ -915,11 +1036,14 @@
 	return 0;
 
 map_err:
