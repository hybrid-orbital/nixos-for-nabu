+	if (map->table)
+		dma_buf_unmap_attachment_unlocked(map->attach, map->table, DMA_BIDIRECTIONAL);
 	dma_buf_detach(map->buf, map->attach);
 attach_err:
 	dma_buf_put(map->buf);
 get_err:
-	fastrpc_map_put(map);
+	kfree(map);
 
 	return err;
 }
@@ -1254,6 +1378,11 @@
 	if (!fl->cctx->rpdev)
 		return -EPIPE;
 
+	/* PDR DOWN is not necessarily accompanied by RPMsg removal. */
