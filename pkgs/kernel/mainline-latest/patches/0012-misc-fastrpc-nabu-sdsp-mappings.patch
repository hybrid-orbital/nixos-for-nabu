+	    (!READ_ONCE(fl->cctx->attach_pd_up) || READ_ONCE(fl->cctx->removing)))
+		return -EPIPE;
+
 	if (handle == FASTRPC_INIT_HANDLE && !kernel) {
 		dev_warn_ratelimited(fl->sctx->dev, "user app trying to send a kernel RPC message (%d)\n",  handle);
 		return -EPERM;
@@ -1630,7 +1759,10 @@
 	struct fastrpc_channel_ctx *cctx = fl->cctx;
 	unsigned long flags;
 
-	fastrpc_release_current_dsp_process(fl);
+	if (!cctx->nabu_sdsp ||
+	    (fl->sensors_attached && READ_ONCE(cctx->attach_pd_up) &&
+	     !READ_ONCE(cctx->removing)))
+		fastrpc_release_current_dsp_process(fl);
 
 	spin_lock_irqsave(&cctx->lock, flags);
 	list_del(&fl->user);
@@ -1733,7 +1865,21 @@
 {
 	struct fastrpc_invoke_args args[1];
 	int client_id = fl->client_id;
+	long ready;
+	int ret;
 	u32 sc;
+
+	if (pd == SENSORS_PD && fl->cctx->nabu_sdsp) {
+		ready = wait_event_interruptible_timeout(fl->cctx->attach_pd_wait,
+			READ_ONCE(fl->cctx->attach_pd_up) || READ_ONCE(fl->cctx->removing),
+			15 * HZ);
+		if (ready < 0)
+			return ready;
+		if (READ_ONCE(fl->cctx->removing))
+			return -EPIPE;
+		if (!ready)
+			return -ETIMEDOUT;
+	}
 
 	args[0].ptr = (u64)(uintptr_t) &client_id;
 	args[0].length = sizeof(client_id);
@@ -1741,8 +1887,11 @@
 	sc = FASTRPC_SCALARS(FASTRPC_RMID_INIT_ATTACH, 1, 0);
 	fl->pd = pd;
 
-	return fastrpc_internal_invoke(fl, true, FASTRPC_INIT_HANDLE,
+	ret = fastrpc_internal_invoke(fl, true, FASTRPC_INIT_HANDLE,
 				       sc, &args[0]);
+	if (!ret && pd == SENSORS_PD)
+		fl->sensors_attached = true;
+	return ret;
 }
 
 static int fastrpc_invoke(struct fastrpc_user *fl, char __user *argp)
@@ -2267,7 +2416,10 @@
 		}
 	}
 	spin_unlock_irqrestore(&cctx->lock, flags);
-	rc = dma_set_mask(dev, DMA_BIT_MASK(dma_bits));
+	if (cctx->nabu_sdsp)
