-/* Extract SMMU PA from consolidated IOVA */
-static inline dma_addr_t fastrpc_ipa_to_dma_addr(struct fastrpc_channel_ctx *cctx, dma_addr_t iova)
-{
-	if (!cctx->soc_data->sid_pos)
-		return 0;
-	return iova & GENMASK_ULL(cctx->soc_data->sid_pos - 1, 0);
-}
-
 /*
  * Prepare the consolidated iova to send to DSP by prepending the SID
  * to smmu PA at the appropriate position
@@ -330,6 +342,70 @@
 				     struct fastrpc_session_ctx *sctx)
 {
 	return (u64)sctx->sid << cctx->soc_data->sid_pos;
+}
+
+/* The nabu firmware consumes the session-tagged address as an IOVA.
+ * Keep DMA-API allocations below 4 GiB and mirror them above that range.
+ * Never pass the tagged address back to the DMA API.
+ */
+static void fastrpc_alias_unmap(struct fastrpc_alias *alias)
+{
+	if (alias->size) {
+		WARN_ON(iommu_unmap(alias->domain, alias->iova, alias->size) != alias->size);
+		alias->size = 0;
+	}
+}
+
+static int fastrpc_alias_map(struct device *dev, dma_addr_t dma, u64 size,
+			     u64 offset, struct fastrpc_alias *alias)
+{
+	struct iommu_domain *domain = iommu_get_domain_for_dev(dev);
+	u64 bytes, start, end;
+	size_t done;
+	unsigned int prot = IOMMU_READ | IOMMU_WRITE;
+	int ret;
+
+	/* This private alias range must never overlap DMA-API allocations. */
+	if (!domain || !iommu_is_dma_domain(domain) ||
+	    dma_get_mask(dev) > DMA_BIT_MASK(32) ||
+	    !(domain->pgsize_bitmap & PAGE_SIZE))
+		return -EOPNOTSUPP;
+	if (!size || size > DMA_BIT_MASK(32) || !IS_ALIGNED(dma, PAGE_SIZE) ||
+	    !offset || !IS_ALIGNED(offset, BIT_ULL(32)))
+		return -EINVAL;
+	bytes = PAGE_ALIGN(size);
+	if (dma + bytes > BIT_ULL(32) || check_add_overflow((u64)dma, offset, &start) ||
+	    check_add_overflow(start, bytes - 1, &end))
+		return -EOVERFLOW;
+	if (domain->geometry.force_aperture &&
+	    (start < domain->geometry.aperture_start || end > domain->geometry.aperture_end))
+		return -ERANGE;
+	if (dev_is_dma_coherent(dev))
+		prot |= IOMMU_CACHE;
+
+	alias->domain = domain;
+	alias->iova = start;
+	for (done = 0; done < bytes; done += PAGE_SIZE) {
+		phys_addr_t phys = iommu_iova_to_phys(domain, dma + done);
+
+		if (!phys || !IS_ALIGNED(phys, PAGE_SIZE)) {
+			ret = -EFAULT;
+			goto rollback;
+		}
+		if (iommu_iova_to_phys(domain, start + done)) {
+			ret = -EEXIST;
+			goto rollback;
+		}
+		ret = iommu_map(domain, start + done, phys, PAGE_SIZE, prot, GFP_KERNEL);
+		if (ret)
+			goto rollback;
+		alias->size += PAGE_SIZE;
+	}
+	return 0;
+
+rollback:
+	fastrpc_alias_unmap(alias);
+	return ret;
 }
 
 static void fastrpc_free_map(struct kref *ref)
