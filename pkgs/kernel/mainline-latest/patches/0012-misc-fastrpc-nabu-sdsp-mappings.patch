 };
 
+#if IS_REACHABLE(CONFIG_QCOM_PDR_HELPERS)
+static void fastrpc_attach_pd_status(int state, char *path, void *priv)
+{
+	struct fastrpc_channel_ctx *cctx = priv;
+
+	WRITE_ONCE(cctx->attach_pd_up, state == SERVREG_SERVICE_STATE_UP);
+	wake_up_all(&cctx->attach_pd_wait);
+}
+
+static int fastrpc_attach_pdr_init(struct fastrpc_channel_ctx *cctx,
+				 struct device_node *node)
+{
+	struct pdr_service *service;
+	const char *name, *path;
+	int ret;
+
+	if (!cctx->nabu_sdsp)
+		return 0;
+	ret = of_property_read_string_index(node, "qcom,protection-domain", 0, &name);
+	if (ret)
+		return ret;
+	ret = of_property_read_string_index(node, "qcom,protection-domain", 1, &path);
+	if (ret)
+		return ret;
+	cctx->attach_pdr = pdr_handle_alloc(fastrpc_attach_pd_status, cctx);
+	if (IS_ERR(cctx->attach_pdr)) {
+		ret = PTR_ERR(cctx->attach_pdr);
+		cctx->attach_pdr = NULL;
+		return ret;
+	}
+	service = pdr_add_lookup(cctx->attach_pdr, name, path);
+	if (IS_ERR(service)) {
+		ret = PTR_ERR(service);
+		pdr_handle_release(cctx->attach_pdr);
+		cctx->attach_pdr = NULL;
+		return ret;
+	}
+	return 0;
+}
+
+static void fastrpc_attach_pdr_release(struct fastrpc_channel_ctx *cctx)
+{
+	if (cctx->attach_pdr)
+		pdr_handle_release(cctx->attach_pdr);
+	cctx->attach_pdr = NULL;
+}
+#else
+static int fastrpc_attach_pdr_init(struct fastrpc_channel_ctx *cctx,
+				 struct device_node *node)
+{
+	return cctx->nabu_sdsp ? -EOPNOTSUPP : 0;
+}
+
+static void fastrpc_attach_pdr_release(struct fastrpc_channel_ctx *cctx) {}
+#endif
