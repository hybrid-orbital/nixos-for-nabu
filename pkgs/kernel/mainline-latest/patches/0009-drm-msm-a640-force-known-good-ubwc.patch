@@ -742,7 +742,28 @@ static void a6xx_set_cp_protect(struct msm_gpu *gpu)
 static void a6xx_set_ubwc_config(struct msm_gpu *gpu)
 {
 	struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
+	struct qcom_ubwc_cfg_data nabu_ubwc_cfg;
 	const struct qcom_ubwc_cfg_data *cfg = adreno_gpu->ubwc_config;
+
+	/*
+	 * nabu workaround: since the UBWC rework this driver trusts the UBWC
+	 * configuration the boot firmware advertises.  On the Xiaomi Pad 5 that
+	 * configuration does not match what the Adreno 640 in this device needs:
+	 * with it the GPU's CCU reads unmapped addresses (gpu fault ... dir=READ
+	 * type=TRANSLATION source=CCU), the ring hangcheck then recovers the GPU
+	 * repeatedly and clients see device resets under load.
+	 *
+	 * Force the values the pre-rework driver used for every non-A8x GPU,
+	 * which are also what the pinned 6.17 kernel boots this device with.
+	 * Everything else still comes from the firmware's config.
+	 */
+	if (adreno_is_a640(adreno_gpu)) {
+		nabu_ubwc_cfg = *cfg;
+		nabu_ubwc_cfg.ubwc_swizzle = 0x6;
+		nabu_ubwc_cfg.highest_bank_bit = 15;
+		cfg = &nabu_ubwc_cfg;
+	}
+
 	/*
 	 * We subtract 13 from the highest bank bit (13 is the minimum value
 	 * allowed by hw) and write the lowest two bits of the remaining value
