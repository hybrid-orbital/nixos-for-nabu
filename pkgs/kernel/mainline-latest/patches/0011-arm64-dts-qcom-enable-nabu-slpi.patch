Subject: [PATCH] arm64: dts: qcom: nabu: configure SLPI context banks and PDR

Match the nabu sensor setup in Kumar-Jy/linux at
739161a890128f23bd1aa679d8754a9ea299269e. The coherent context-bank
attributes are an experimental board/firmware assumption requiring hardware
validation. Do not reuse the SLPI firmware carveout as a physical RPC heap.
Requires the paired nabu SDSP alias/PDR driver patch.

diff --git a/arch/arm64/boot/dts/qcom/sm8150-xiaomi-nabu.dts b/arch/arm64/boot/dts/qcom/sm8150-xiaomi-nabu.dts
--- a/arch/arm64/boot/dts/qcom/sm8150-xiaomi-nabu.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-xiaomi-nabu.dts
@@ -791,6 +791,30 @@
 	firmware-name = "qcom/sm8150/xiaomi/nabu/cdsp.mbn";
 };
 
+&remoteproc_slpi {
+	firmware-name = "qcom/sm8150/xiaomi/nabu/slpi_nb.mbn";
+	status = "okay";
+
+	glink-edge {
+		fastrpc {
+			qcom,protection-domain = "tms/servreg", "msm/slpi/root_pd";
+
+			/* Match the nabu firmware/context-bank mapping used by
+			 * the working reference. No physical remote heap is used.
+			 */
+			compute-cb@1 {
+				dma-coherent;
+			};
+			compute-cb@2 {
+				dma-coherent;
+			};
+			compute-cb@3 {
+				dma-coherent;
+			};
+		};
+	};
+};
+
 &remoteproc_mpss {
 	status = "okay";
 	firmware-name = "qcom/sm8150/xiaomi/nabu/modem.mbn";
