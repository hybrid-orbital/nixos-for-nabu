diff --git a/drivers/clk/qcom/clk-regmap.c b/drivers/clk/qcom/clk-regmap.c
index 92ac4e0..e4b5295 100644
--- a/drivers/clk/qcom/clk-regmap.c
+++ b/drivers/clk/qcom/clk-regmap.c
@@ -4,6 +4,7 @@
  */
 
 #include <linux/device.h>
+#include <linux/delay.h>
 #include <linux/clk-provider.h>
 #include <linux/regmap.h>
 #include <linux/export.h>
@@ -55,6 +56,15 @@ int clk_enable_regmap(struct clk_hw *hw)
 	else
 		val = rclk->enable_mask;
 
+	/*
+	 * Downstream workaround: without this settle time the enable write can
+	 * race the block and the clock stays "stuck in off state", which shows
+	 * up as a broken UFS controller or a dead DSI link.  Ported from the
+	 * sm8150-mainline/nabu kernels; harmless but adds 2.5 ms per regmap
+	 * clock toggle.
+	 */
+	udelay(2500);
+
 	return regmap_update_bits(rclk->regmap, rclk->enable_reg,
 				  rclk->enable_mask, val);
 }
@@ -79,6 +89,9 @@ void clk_disable_regmap(struct clk_hw *hw)
 	else
 		val = 0;
 
+	/* Same settle time as in clk_enable_regmap() (see above). */
+	udelay(2500);
+
 	regmap_update_bits(rclk->regmap, rclk->enable_reg, rclk->enable_mask,
 			   val);
 }
