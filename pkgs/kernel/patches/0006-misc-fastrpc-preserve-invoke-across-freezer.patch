From: Nabu NixOS maintainers
Subject: [PATCH] misc: fastrpc: preserve in-flight invokes across freezing

On nabu, a freezer-only PM test reproduces the SLPI frpc_dsp exception
without suspending devices. Kretprobe shows the listener invoke returning
-ERESTARTSYS, followed by a fresh invoke after thaw. Restarting this ioctl
allocates another context and sends the non-idempotent listener RPC again.

Sleep in TASK_FREEZABLE so the freezer can preserve the in-flight wait.
Handle a racing freeze request before leaving the ioctl too. Keep ordinary
signal interruption and the kernel RPC timeout unchanged. This is scoped
to freezing; it does not implement general signal-interrupted RPC replay.

Both supported kernels export wait_for_completion_state().

---
--- a/drivers/misc/fastrpc.c
+++ b/drivers/misc/fastrpc.c
@@ -3,6 +3,7 @@
 // Copyright (c) 2018, Linaro Limited
 
 #include <linux/completion.h>
+#include <linux/freezer.h>
 #include <linux/device.h>
 #include <linux/dma-buf.h>
 #include <linux/dma-mapping.h>
@@ -1363,6 +1364,24 @@
 
 }
 
+/* Keep the same DSP request alive across a system freeze. */
+static int fastrpc_wait_for_user_completion(struct completion *work)
+{
+	int err;
+
+	do {
+		err = wait_for_completion_state(work,
+				TASK_INTERRUPTIBLE | TASK_FREEZABLE);
+		/* A freeze request can race with entering the freezable wait.
+		 * Consume that request here rather than restart the ioctl and
+		 * send a second RPC while the first is still outstanding.
+		 * Real signals outside freezing retain the interruptible ABI.
+		 */
+	} while (err == -ERESTARTSYS && try_to_freeze());
+
+	return err;
+}
+
 static int fastrpc_internal_invoke(struct fastrpc_user *fl,  u32 kernel,
 				   u32 handle, u32 sc,
 				   struct fastrpc_invoke_args *args)
@@ -1407,7 +1426,7 @@
 		if (!wait_for_completion_timeout(&ctx->work, 10 * HZ))
 			err = -ETIMEDOUT;
 	} else {
-		err = wait_for_completion_interruptible(&ctx->work);
+		err = fastrpc_wait_for_user_completion(&ctx->work);
 	}
 
 	if (err)
