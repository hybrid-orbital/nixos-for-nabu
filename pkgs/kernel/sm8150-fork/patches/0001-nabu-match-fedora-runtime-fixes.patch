diff --git a/drivers/net/wireless/ath/ath10k/thermal.c b/drivers/net/wireless/ath/ath10k/thermal.c
index 5dbd2b3f6676..e3738073afba 100644
--- a/drivers/net/wireless/ath/ath10k/thermal.c
+++ b/drivers/net/wireless/ath/ath10k/thermal.c
@@ -158,6 +158,17 @@ int ath10k_thermal_register(struct ath10k *ar)
 	struct device *hwmon_dev;
 	int ret;
 
+	/*
+	 * The WCN3990 firmware used on SM8150 advertises thermal throttling,
+	 * but hangs when ath10k reads it. Thermal monitoring is provided by
+	 * the platform TSENS driver, so disable ath10k's internal facility on
+	 * the SNOC bus. This matches the nabu Fedora kernel source.
+	 */
+	if (ar->hif.bus == ATH10K_BUS_SNOC &&
+	    test_bit(WMI_SERVICE_THERM_THROT, ar->wmi.svc_map)) {
+		clear_bit(WMI_SERVICE_THERM_THROT, ar->wmi.svc_map);
+	}
+
 	if (!test_bit(WMI_SERVICE_THERM_THROT, ar->wmi.svc_map))
 		return 0;
 
