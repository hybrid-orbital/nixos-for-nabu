# Boot-chain invariants. The kernel build checks the final, post-nixpkgs
# .config against these exact values so a nixpkgs update cannot silently
# remove a driver needed to reach the root filesystem or light the panel.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_RD_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EFI_PARTITION=y
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y
CONFIG_TMPFS=y
CONFIG_OF=y
CONFIG_FW_LOADER=y

# UFS root storage
CONFIG_SCSI=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y

# Early display
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL_NOVATEK_NT36523=m
CONFIG_BACKLIGHT_KTZ8866=m
CONFIG_SYSFB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_DRM_FBDEV_EMULATION=y

# Qualcomm coprocessors, Wi-Fi, and audio
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_RPMSG_QCOM_GLINK_SMEM=m
CONFIG_QRTR=m
CONFIG_QCOM_PD_MAPPER=m
CONFIG_QCOM_RMTFS_MEM=y
CONFIG_ATH10K=m
CONFIG_ATH10K_SNOC=m
CONFIG_SND_SOC_SM8150=m

# Kept in sync with the Fedora extra-sm8150.config fragment
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# NixOS firewall (verified by booting the rootfs in QEMU)
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=m
CONFIG_IP_NF_MATCH_RPFILTER=m
CONFIG_IP6_NF_MATCH_RPFILTER=m
