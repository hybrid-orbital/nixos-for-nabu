+// The login UI consumes wl_pointer, not tablet-v2. Use the pen as a pointer
+// here; pressure and drawing remain the responsibility of the desktop session.
+static void tablet_pointer_button(struct greeter_server* server, uint32_t time_msec, bool pressed) {
+  if (server->tablet_tip_down == pressed) {
+    return;
+  }
+  server->tablet_tip_down = pressed;
+  wlr_seat_pointer_notify_button(server->seat, time_msec, BTN_LEFT,
+      pressed ? WL_POINTER_BUTTON_STATE_PRESSED : WL_POINTER_BUTTON_STATE_RELEASED);
+  wlr_seat_pointer_notify_frame(server->seat);
+}
+
+static void handle_tablet_tool_destroy(struct wl_listener* listener, void* data) {
+  (void)data;
+  struct greeter_server* server = wl_container_of(listener, server, tablet_tool_destroy);
+  tablet_pointer_button(server, 0, false);
+  wl_list_remove(&server->tablet_tool_destroy.link);
+  server->tablet_tool_destroy.notify = NULL;
+  server->pointer_tool = NULL;
+}
+
+static void tablet_pointer_motion(struct greeter_server* server, struct wlr_tablet* tablet, double x, double y) {
+  note_pointer_activity(server);
+  wlr_cursor_warp_absolute(server->cursor, &tablet->base, x, y);
+  pointer_focus(server, server->cursor->x, server->cursor->y);
+  wlr_seat_pointer_notify_frame(server->seat);
+}
+
+static void handle_cursor_tablet_proximity(struct wl_listener* listener, void* data) {
+  struct greeter_server* server = wl_container_of(listener, server, cursor_tablet_proximity);
+  struct wlr_tablet_tool_proximity_event* event = data;
+  if (event->state == WLR_TABLET_TOOL_PROXIMITY_OUT) {
+    if (event->tool == server->pointer_tool) {
+      tablet_pointer_button(server, event->time_msec, false);
+      wl_list_remove(&server->tablet_tool_destroy.link);
+      server->tablet_tool_destroy.notify = NULL;
+      server->pointer_tool = NULL;
+    }
+    return;
+  }
+  if (server->pointer_tool != event->tool) {
+    tablet_pointer_button(server, event->time_msec, false);
+    if (server->pointer_tool != NULL) {
+      wl_list_remove(&server->tablet_tool_destroy.link);
+    }
+    server->pointer_tool = event->tool;
+    server->tablet_tool_destroy.notify = handle_tablet_tool_destroy;
+    wl_signal_add(&event->tool->events.destroy, &server->tablet_tool_destroy);
+  }
+  tablet_pointer_motion(server, event->tablet, event->x, event->y);
+}
+
+static void handle_cursor_tablet_axis(struct wl_listener* listener, void* data) {
+  struct greeter_server* server = wl_container_of(listener, server, cursor_tablet_axis);
+  struct wlr_tablet_tool_axis_event* event = data;
+  if (event->tool != server->pointer_tool || !(event->updated_axes & (WLR_TABLET_TOOL_AXIS_X | WLR_TABLET_TOOL_AXIS_Y))) {
+    return;
+  }
+  // wlroots rotates the axis flags too. Preserve an axis that did not change.
+  tablet_pointer_motion(server, event->tablet,
+      event->updated_axes & WLR_TABLET_TOOL_AXIS_X ? event->x : NAN,
+      event->updated_axes & WLR_TABLET_TOOL_AXIS_Y ? event->y : NAN);
+}
+
+static void handle_cursor_tablet_tip(struct wl_listener* listener, void* data) {
+  struct greeter_server* server = wl_container_of(listener, server, cursor_tablet_tip);
+  struct wlr_tablet_tool_tip_event* event = data;
+  if (event->tool != server->pointer_tool) {
+    return;
+  }
+  note_activity(server);
+  tablet_pointer_motion(server, event->tablet, event->x, event->y);
+  tablet_pointer_button(server, event->time_msec, event->state == WLR_TABLET_TOOL_TIP_DOWN);
+}
